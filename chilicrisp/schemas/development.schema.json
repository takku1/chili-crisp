{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "concept", "project_config", "benchmark_command", "objective"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["backend", "manifest", "benchmark_workload", "initial_budget"],
      "properties": {
        "backend": {"const": "linux_cgroup"},
        "manifest": {"type": "string", "minLength": 1},
        "benchmark_workload": {"type": "string", "minLength": 1},
        "initial_budget": {"type": "integer", "minimum": 4096}
      }
    },
    "concept": {"type": "string", "minLength": 1},
    "project_config": {"type": "string", "minLength": 1},
    "benchmark_command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "objective": {"$ref": "#/$defs/metric"},
    "artifact_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "regression_limits": {"type": "object", "propertyNames": {"$ref": "#/$defs/metric"}, "additionalProperties": {"type": "number", "minimum": 0, "maximum": 100}},
    "reductions": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}},
    "minimum_target": {"type": "number", "exclusiveMinimum": 0},
    "quantum": {"type": "number", "exclusiveMinimum": 0},
    "repetitions": {"type": "integer", "minimum": 2, "maximum": 20},
    "confirmation_repetitions": {"type": "integer", "minimum": 2, "maximum": 20},
    "max_generations": {"type": "integer", "minimum": 1, "maximum": 1000},
    "max_stagnation": {"type": "integer", "minimum": 1, "maximum": 1000},
    "max_commands": {"type": "integer", "minimum": 1, "maximum": 100000},
    "wall_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 604800},
    "seed": {"type": "integer"}
  },
  "$defs": {"metric": {"enum": ["enforced_budget_bytes", "native_memory_peak_bytes", "wall_seconds", "sampled_peak_rss_bytes", "sampled_cpu_seconds", "artifact_bytes", "sampled_io_read_bytes", "sampled_io_write_bytes"]}}
}
