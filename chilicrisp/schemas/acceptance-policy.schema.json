{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "campaign", "manifest", "manifest_sha256", "benchmark_workload", "transfer_budget", "repetitions", "seed", "wall_seconds", "max_trials", "maximum_latency_regression", "minimum_memory_improvement"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "campaign": {"type": "string", "minLength": 1, "maxLength": 128},
    "manifest": {"type": "string", "minLength": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "build": {
      "type": "object", "additionalProperties": false, "required": ["manifest", "manifest_sha256", "memory_budget"],
      "properties": {"manifest": {"type": "string", "minLength": 1},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "memory_budget": {"type": "integer", "minimum": 4096}}
    },
    "benchmark_workload": {"type": "string", "minLength": 1},
    "transfer_budget": {"type": "integer", "minimum": 4096},
    "repetitions": {"type": "integer", "minimum": 3, "maximum": 20},
    "seed": {"type": "integer"},
    "wall_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600},
    "max_trials": {"type": "integer", "minimum": 1, "maximum": 1000},
    "maximum_latency_regression": {"type": "number", "minimum": 0, "maximum": 10},
    "minimum_memory_improvement": {"type": "number", "minimum": 0, "exclusiveMaximum": 1}
  }
}
