{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chilicrisp.local/schemas/experiment.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "experiment_id", "target", "workloads", "isolation", "search", "limits", "acceptance", "hidden_evaluation", "evidence_directory"],
  "properties": {
    "baseline": {
      "type": "object", "additionalProperties": false,
      "required": ["trials", "margin_fraction"],
      "properties": {
        "trials": {"type": "integer", "minimum": 2, "maximum": 100},
        "margin_fraction": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "schema_version": {"const": "0.1"},
    "experiment_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]{1,64}$"},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["source_hash", "build_identity", "rootfs", "rootfs_hash", "command"],
      "properties": {
        "source_hash": {"$ref": "#/$defs/hash"},
        "build_identity": {"type": "string", "minLength": 1},
        "rootfs": {"type": "string", "minLength": 1},
        "rootfs_hash": {"$ref": "#/$defs/hash"},
        "command": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "workloads": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "input", "input_hash", "arguments"],
        "oneOf": [
          {"required": ["expected_stdout_hash"], "not": {"required": ["oracle"]}},
          {"required": ["oracle"], "not": {"required": ["expected_stdout_hash"]}}
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "input": {"type": "string", "minLength": 1},
          "input_hash": {"$ref": "#/$defs/hash"},
          "expected_stdout_hash": {"$ref": "#/$defs/hash"},
          "oracle": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "policy_path", "policy_hash"],
            "properties": {
              "kind": {"enum": ["worldgame_ocean_v1", "worldgame_fields_v1"]},
              "policy_path": {"type": "string", "minLength": 1},
              "policy_hash": {"$ref": "#/$defs/hash"}
            }
          },
          "arguments": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "isolation": {
      "type": "object", "additionalProperties": false,
      "required": ["backend", "cgroup_parent", "cache_policy", "network", "swap_bytes", "pids", "file_descriptors", "scratch_bytes", "seccomp"],
      "properties": {
        "backend": {"const": "bubblewrap"},
        "cgroup_parent": {"type": "string", "minLength": 1},
        "cache_policy": {"const": "qualified_warm"},
        "network": {"const": "none"}, "swap_bytes": {"const": 0},
        "pids": {"type": "integer", "minimum": 1, "maximum": 1024},
        "file_descriptors": {"type": "integer", "minimum": 16, "maximum": 4096},
        "scratch_bytes": {"type": "integer", "minimum": 4096},
        "seccomp": {"const": "pilot_allowlist_v1"}
      }
    },
    "search": {
      "type": "object", "additionalProperties": false,
      "required": ["initial_budget", "minimum_budget", "initial_reduction", "maximum_reduction", "tolerance", "confirmation_trials", "max_trials", "page_size"],
      "properties": {
        "initial_budget": {"type": "integer", "minimum": 4096},
        "minimum_budget": {"type": "integer", "minimum": 4096},
        "initial_reduction": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "maximum_reduction": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "tolerance": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "confirmation_trials": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_trials": {"type": "integer", "minimum": 1, "maximum": 10000},
        "page_size": {"type": "integer", "minimum": 1}
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["timeout_seconds", "output_bytes_per_stream", "experiment_seconds", "candidate_count"],
      "properties": {
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0, "maximum": 3600},
        "output_bytes_per_stream": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "experiment_seconds": {"type": "number", "exclusiveMinimum": 0},
        "candidate_count": {"type": "integer", "minimum": 1}
      }
    },
    "acceptance": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_memory_improvement_fraction", "maximum_latency_regression_fraction"],
      "properties": {
        "minimum_memory_improvement_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_latency_regression_fraction": {"type": "number", "minimum": 0}
      }
    },
    "hidden_evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["confirmation_reference", "final_reference"],
      "properties": {
        "confirmation_reference": {"type": "string", "minLength": 1},
        "final_reference": {"type": "string", "minLength": 1}
      }
    },
    "evidence_directory": {"type": "string", "minLength": 1}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
